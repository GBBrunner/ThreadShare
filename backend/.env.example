# Server Configuration
PORT=3005
# GARRETTS_RENDER_SERVER_URL=https://student-registration-app-pixn.onrender.com

# Database Configuration - Railway
# Get your connection URL from: Railway Dashboard > Postgres Service > Connect > Public URL
# Format: postgresql://postgres:[YOUR-PASSWORD]@[HOST].railway.app:[PORT]/railway
RAILWAY_DB_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.railway.app:PORT/railway

# Optional: Force SSL connection (automatically enabled for Railway and Render)
# DB_SSL=true

# Server URL (for production deployment)
RENDER_SERVER_URL=http://localhost:3005
