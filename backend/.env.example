# Server Configuration
PORT=3005
# GARRETTS_RENDER_SERVER_URL=https://student-registration-app-pixn.onrender.com

# Database Configuration - Supabase
# Get your Supabase database URL from: Project Settings > Database > Connection String
# 
# Direct Connection (port 5432) - Use for development:
# Format: postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
SUPABASE_DB_URL=postgresql://postgres:YOUR_PASSWORD@db.xxxxx.supabase.co:5432/postgres
#
# Connection Pooler (port 6543) - Recommended for production with connection issues:
# SUPABASE_DB_URL=postgresql://postgres:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# Note: If you get IPv6 errors on Render, try the pooler URL or check Supabase Network Restrictions

# Optional: Legacy Render database URL (fallback)
# DB_URL=postgresql://user:password@host.render.com/database

# Optional: Force SSL connection (automatically enabled for Supabase and Render)
# DB_SSL=true

# Server URL (for production deployment)
RENDER_SERVER_URL=http://localhost:3005
